{
  "streamId": "2026-spring",
  "name": "RS Tandem 2026",
  "startDate": "2026-02-17",
  "endDate": "2026-04-06",
  "durationWeeks": 7,
  "cloneBranch": "main",
  "monitoringAccount": "rollingscopes",
  "checkpoints": [
    {
      "id": "w1",
      "label": "Week 1: Setup & Diary",
      "startDate": "2026-02-17",
      "rules": [
        { "id": "diary", "type": "diary", "scope": "member", "points": 20, "params": { "minEntries": 2 } },
        { "id": "repoPublic", "type": "custom", "scope": "team", "points": 0 },
        { "id": "readme", "type": "custom", "scope": "team", "points": 0 },
        { "id": "teamList", "type": "custom", "scope": "team", "points": 0 }
      ]
    },
    {
      "id": "w2",
      "label": "Week 2: Deploy & CI",
      "startDate": "2026-02-23",
      "teamRequiresPersonal": true,
      "rules": [
        { "id": "diaryW2", "type": "diary", "scope": "member", "points": 5, "params": { "minEntries": 2, "afterDate": "2026-02-23" } },
        { "id": "assigned", "type": "issue-assignment", "scope": "member", "points": 5, "params": { "minAssigned": 1 } },
        { "id": "deploy", "type": "deploy", "scope": "team", "points": 5 },
        { "id": "ci", "type": "ci", "scope": "team", "points": 0 },
        { "id": "issues", "type": "issues", "scope": "team", "points": 2.5, "params": { "minCount": 6 } },
        { "id": "linter", "type": "linter", "scope": "team", "points": 2.5 }
      ]
    },
    {
      "id": "w3",
      "label": "Week 3: Video Presentation",
      "startDate": "2026-03-02",
      "rules": [
        { "id": "diaryW3", "type": "diary", "scope": "member", "points": 10, "params": { "minEntries": 2, "afterDate": "2026-03-02" } },
        { "id": "videoInDiary", "type": "video", "scope": "member", "points": 10 }
      ]
    },
    {
      "id": "w4",
      "label": "Week 4: Unit Testing & Code Review",
      "startDate": "2026-03-09",
      "rules": [
        { "id": "diaryW4", "type": "diary", "scope": "member", "points": 0, "params": { "minEntries": 2, "afterDate": "2026-03-09" } },
        { "id": "testing", "type": "testing", "scope": "member", "points": 10, "params": { "minTests": 5 } },
        { "id": "review", "type": "review", "scope": "member", "points": 10, "params": { "minMeaningfulComments": 3 } }
      ]
    },
    {
      "id": "w5",
      "label": "Week 5: 404, Loading & Error Handling",
      "startDate": "2026-03-16",
      "teamRequiresPersonal": true,
      "rules": [
        { "id": "diaryW5", "type": "diary", "scope": "member", "points": 10, "params": { "minEntries": 2, "afterDate": "2026-03-16" } },
        { "id": "readmeVideo", "type": "readme-video", "scope": "team", "points": 10 }
      ]
    },
    {
      "id": "w6",
      "label": "Week 6: Final Diary Grade",
      "startDate": "2026-03-23",
      "rules": [
        {
          "id": "diaryGate",
          "type": "diary",
          "scope": "member",
          "points": 0,
          "params": { "minEntries": 2, "afterDate": "2026-03-23" },
          "description": "Gate: ≥2 entries after Mar 23. No points, but required for grading."
        }
      ],
      "grading": {
        "maxPoints": 100,
        "components": [
          {
            "id": "regularity",
            "label": "Регулярность",
            "maxPoints": 20,
            "source": "deterministic",
            "description": "Consistency of writing across all 6 weeks. Penalizes cramming.",
            "params": {
              "weeksExpected": 6,
              "minWeeksForMax": 5
            }
          },
          {
            "id": "volume",
            "label": "Объём",
            "maxPoints": 10,
            "source": "deterministic",
            "description": "Total meaningful content. Not rewarding length for its own sake — penalizing empty/one-liner entries.",
            "params": {
              "minAvgCharsForMax": 500,
              "minTotalEntries": 6
            }
          },
          {
            "id": "noticeability",
            "label": "Заметность Tandi",
            "maxPoints": 20,
            "source": "scan-data",
            "description": "How often Tandi noticed this student across issues. Based on scan tag scores ≥ 0.7.",
            "params": {
              "scoreThreshold": 0.7,
              "issueRange": [2, 6]
            }
          },
          {
            "id": "reflection",
            "label": "Глубина рефлексии",
            "maxPoints": 50,
            "source": "llm",
            "description": "Quality of self-analysis: comparing approaches, describing decisions and trade-offs, honest about failures, visible growth. Graded by LLM on smart context (first+last entry + scan summary).",
            "rubric": {
              "0-10": "Формальный: 'сделал X, потом Y'. Нет анализа.",
              "11-25": "Описательный: есть детали, но нет 'почему'. Пересказ действий.",
              "26-40": "Аналитический: описывает проблемы и решения, видны решения и альтернативы.",
              "41-50": "Рефлексивный: сравнивает подходы, честен про ошибки, видно как менялось мышление."
            }
          }
        ]
      }
    }
  ]
}
