{
  "streamId": "2026-spring",
  "name": "RS Tandem 2026",
  "startDate": "2026-02-17",
  "endDate": "2026-04-06",
  "durationWeeks": 7,
  "cloneBranch": "main",
  "monitoringAccount": "rollingscopes",
  "language": "ru",
  "deploy": {
    "repo": "rollingscopes/rs-tandem-observer",
    "baseUrl": "/rs-tandem-observer/"
  },
  "branding": {
    "title": "RS Tandem — Observer",
    "teamsTitle": "RS Tandem — Teams",
    "issueRepo": "rollingscopes/rs-tandem-observer"
  },
  "checkpoints": [
    {
      "id": "w1",
      "label": "Week 1: Setup & Diary",
      "startDate": "2026-02-17",
      "rules": [
        { "id": "diary", "type": "diary", "scope": "member", "points": 20, "params": { "minEntries": 2 } },
        { "id": "repoPublic", "type": "custom", "scope": "team", "points": 0 },
        { "id": "readme", "type": "custom", "scope": "team", "points": 0 },
        { "id": "teamList", "type": "custom", "scope": "team", "points": 0 }
      ]
    },
    {
      "id": "w2",
      "label": "Week 2: Deploy & CI",
      "startDate": "2026-02-23",
      "teamRequiresPersonal": true,
      "rules": [
        { "id": "diaryW2", "type": "diary", "scope": "member", "points": 5, "params": { "minEntries": 2, "afterDate": "2026-02-23" } },
        { "id": "assigned", "type": "issue-assignment", "scope": "member", "points": 5, "params": { "minAssigned": 1 } },
        { "id": "deploy", "type": "deploy", "scope": "team", "points": 5 },
        { "id": "ci", "type": "ci", "scope": "team", "points": 0 },
        { "id": "issues", "type": "issues", "scope": "team", "points": 2.5, "params": { "minCount": 6 } },
        { "id": "linter", "type": "linter", "scope": "team", "points": 2.5 }
      ]
    },
    {
      "id": "w3",
      "label": "Week 3: Video Presentation",
      "startDate": "2026-03-02",
      "rules": [
        { "id": "diaryW3", "type": "diary", "scope": "member", "points": 10, "params": { "minEntries": 2, "afterDate": "2026-03-02" } },
        { "id": "videoInDiary", "type": "video", "scope": "member", "points": 10 }
      ]
    },
    {
      "id": "w4",
      "label": "Week 4: Unit Testing & Code Review",
      "startDate": "2026-03-09",
      "rules": [
        { "id": "diaryW4", "type": "diary", "scope": "member", "points": 0, "params": { "minEntries": 2, "afterDate": "2026-03-09" } },
        { "id": "testing", "type": "testing", "scope": "member", "points": 10, "params": { "minTests": 5 } },
        { "id": "review", "type": "review", "scope": "member", "points": 10, "params": { "minMeaningfulComments": 3 } }
      ]
    },
    {
      "id": "w5",
      "label": "Week 5: 404, Loading & Error Handling",
      "startDate": "2026-03-16",
      "teamRequiresPersonal": true,
      "rules": [
        { "id": "diaryW5", "type": "diary", "scope": "member", "points": 10, "params": { "minEntries": 2, "afterDate": "2026-03-16" } },
        { "id": "readmeVideo", "type": "readme-video", "scope": "team", "points": 10 }
      ]
    },
    {
      "id": "w6",
      "label": "Week 6: Final Diary Grade",
      "startDate": "2026-03-23",
      "rules": [
        {
          "id": "diaryGate",
          "type": "diary",
          "scope": "member",
          "points": 0,
          "params": { "minEntries": 2, "afterDate": "2026-03-23" },
          "description": "Gate: ≥2 entries after Mar 23. No points, but required for grading."
        }
      ],
      "grading": {
        "maxPoints": 100,
        "algorithm": "v2-ladder",
        "description": "4 discrete levels from WEEK6_CHECKPOINT spec. Code determines 0/20/60, LLM binary questions upgrade to 80/100.",
        "levels": [
          {
            "score": 0,
            "label": "Нет дневника",
            "source": "deterministic",
            "description": "No diary or gate failed (< 2 entries after Mar 23)"
          },
          {
            "score": 20,
            "label": "Формальный",
            "source": "deterministic",
            "description": "Entries exist but irregular (< 5 of 6 weeks with entries)"
          },
          {
            "score": 60,
            "label": "Регулярный",
            "source": "deterministic",
            "description": "≥ 2 entries/week in ≥ 5 weeks, 2 components described",
            "params": {
              "weeksExpected": 6,
              "minWeeksForRegular": 5
            }
          },
          {
            "score": 80,
            "label": "Детальный",
            "source": "llm-binary",
            "description": "Diary contains specific technical problems and their solutions",
            "question": "Содержит ли дневник описание конкретных технических проблем и способов их решения?"
          },
          {
            "score": 100,
            "label": "Рефлексивный",
            "source": "llm-binary",
            "description": "Diary contains comparison of implementation approaches with trade-offs",
            "question": "Содержит ли дневник сравнение нескольких вариантов реализации с описанием trade-offs?"
          }
        ]
      }
    },
    {
      "id": "w7",
      "label": "Week 7: Presentation Prep",
      "startDate": "2026-03-30",
      "deadline": "2026-04-07T23:59:00Z",
      "rules": [
        {
          "id": "deploy",
          "type": "deploy",
          "scope": "team",
          "points": 0,
          "description": "App accessible via deploy link from README"
        },
        {
          "id": "readmeArtifacts",
          "type": "custom",
          "scope": "team",
          "points": 0,
          "description": "README has: about (description + demo video + proud-of), team, board, best PRs, meeting notes"
        },
        {
          "id": "selfAssessment",
          "type": "custom",
          "scope": "member",
          "points": 0,
          "description": "self-assessment.md exists in development-notes/{github}/ on main"
        }
      ],
      "scoring": {
        "maxPoints": 20,
        "algorithm": "split-10-10",
        "description": "self-assessment → 10 personal, self-assessment + team OK → +10 team"
      }
    }
  ]
}
